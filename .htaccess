# Bertina Linux/cPanel deployment policy
# Generated from the frozen migration baseline. Keep public URLs unchanged.

DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 "This content is permanently unavailable. Visit the current bookstore through the main website."

<IfModule mod_rewrite.c>
RewriteEngine On

# JHELA public-site recovery: TEMPORARY host-scoped redirect only.
# Until a separately audited native subdomain is deployed, preserve all public
# journal pages, styles, login links and SEO canonicals at the working apex.
# GET/HEAD only; never forward POST bodies, passwords or manuscript uploads.
# 302 is intentional: a future native subdomain must not inherit a cached 301.
RewriteCond %{HTTP_HOST} ^journal\.drjavadrezazadeh\.com(?::[0-9]+)?$ [NC]
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteRule ^ - [F,L]
RewriteCond %{HTTP_HOST} ^journal\.drjavadrezazadeh\.com(?::[0-9]+)?$ [NC]
RewriteRule ^journal(?:/(.*))?$ https://drjavadrezazadeh.com/journal/$1 [R=302,L,NE]
RewriteCond %{HTTP_HOST} ^journal\.drjavadrezazadeh\.com(?::[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://drjavadrezazadeh.com/journal/$1 [R=302,L,NE]


# Retired journal vendor stylesheet: return 410 even if an older deploy left the file on disk.
# Never allow archived journal code to appear as an active public asset.
RewriteRule ^assets/css/jhela-ojs-theme\.css$ - [G,L]

# Resolve verified public legacy paths directly to their HTTPS apex destination.
# These must precede transport consolidation to avoid HTTP/www redirect chains.
RewriteRule ^about/?$ https://drjavadrezazadeh.com/en/about/ [R=301,L,NE]
RewriteRule ^academic-engagements/?$ https://drjavadrezazadeh.com/en/academic-engagements/ [R=301,L,NE]
RewriteRule ^books/?$ https://drjavadrezazadeh.com/en/books/ [R=301,L,NE]
RewriteRule ^educational-philosophy/?$ https://drjavadrezazadeh.com/en/educational-philosophy/ [R=301,L,NE]
RewriteRule ^golden-talent/?$ https://drjavadrezazadeh.com/en/golden-talent/ [R=301,L,NE]
# GSC-confirmed missing /home/ is a specific homepage alias, not a catch-all 404 redirect.
# Place before transport consolidation: HTTPS/HTTP, www/apex, slash/slashless => one canonical 301.
RewriteRule ^home/?$ https://drjavadrezazadeh.com/ [R=301,L,NE]
RewriteRule ^publications/?$ https://drjavadrezazadeh.com/en/publications/ [R=301,L,NE]
RewriteRule ^research/?$ https://drjavadrezazadeh.com/en/research/ [R=301,L,NE]
RewriteRule ^teaching/?$ https://drjavadrezazadeh.com/en/teaching/ [R=301,L,NE]
RewriteRule ^shop/?$ https://drjavadrezazadeh.com/fa/shop/ [R=301,L,NE]

# Replace the rejected old vector illustration with the owner's approved original banner.
RewriteRule ^assets/images/talent-bookstore-hero-3d\\.svg$ /assets/images/bookstore-talent-cinematic-approved-20261011.webp [R=301,L,NE]
# Permanently retired former-product URLs return HTTP 410 without a misleading redirect.
RewriteRule ^fa/archive/legacy-shop(?:/index\.html)?/?$ - [G,L]
# Historical product paths remain as non-indexable routing signatures only.
RewriteRule ^product/خرید-فرش-ماشینی-کد-2-7801-8833/?$ - [G,L]
RewriteRule ^product/خرید-فرش-ماشینی-کد-2-7801-9735/?$ - [G,L]
RewriteRule ^product/خرید-فرش-ماشینی-کد-4301-4917/?$ - [G,L]
RewriteRule ^product/خرید-فرش-ماشینی-کد-4301-5021/?$ - [G,L]
RewriteRule ^product/خرید-گبه-ماشینی-کد-1009-2/?$ - [G,L]
RewriteRule ^product/خرید-گبه-ماشینی-کد-3001-3283/?$ - [G,L]

# Canonical transport for current and unknown paths; preserve the request path.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.drjavadrezazadeh\.com$ [NC]
RewriteRule ^ https://drjavadrezazadeh.com%{REQUEST_URI} [R=301,L,NE]

# Preserve the existing private authentication migrations.
RewriteRule ^login/?$ https://drjavadrezazadeh.com/en/login/ [R=301,L,NE]
RewriteRule ^register/?$ https://drjavadrezazadeh.com/en/register/ [R=301,L,NE]
</IfModule>

<IfModule mod_setenvif.c>
SetEnvIf Request_URI "^/(api|fa/exams/my|en/exams/my|fa/customer-dashboard|fa/services/checkout|fa/shop/golden-talent/checkout|fa/app|app|fa/login|login|fa/register|register|fa/bazyabi-hesab|en/login|en/register|en/recover|en/account|fa/assessments|assessments|fa/shop/(cart|checkout|payment-start|payment-return|payment-result)|en/shop/(cart|checkout)|en/golden-talent/(assessment|dashboard|observer|roles|student|checkout|plans)|fa/darkhast-moshavere|en/request-consultation)(/|$)" PRIVATE_ROUTE=1
# ErrorDocument redirects rename request environment flags; preserve private 404 headers.
SetEnvIfExpr "reqenv('REDIRECT_PRIVATE_ROUTE') == '1'" PRIVATE_ROUTE=1
</IfModule>

<IfModule mod_headers.c>
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# Public documents/default responses must revalidate so SEO/indexing changes are visible immediately.
# Keep this at directory scope so a private route can override it reliably.
Header always set Cache-Control "public, no-cache, must-revalidate" env=!PRIVATE_ROUTE

# Mutable CSS, JavaScript, JSON and media require revalidation on ordinary navigation.
# Conditional requests still use ETag / Last-Modified; no month-old cover or stale script.
<FilesMatch "\.(?:css|js|mjs|json|webmanifest|png|jpe?g|webp|avif|gif|svg|ico|woff2?|ttf|otf)$">
Header always set Cache-Control "public, no-cache, must-revalidate" env=!PRIVATE_ROUTE
</FilesMatch>

# Content-addressed, locally hosted Persian heading font: blob identity is pinned
# in its actual filename. Safe to retain for repeat visits on slower networks.
# No mutable CSS/JS, HTML, API, checkout, dashboard or user content qualifies.
<FilesMatch "^vazirmatn-variable-a501289a8559\.woff2$">
Header always set Cache-Control "public, max-age=31536000, immutable" env=!PRIVATE_ROUTE
</FilesMatch>

# The Bertina release assembler builds /assets/css/style.<SHA256_12>.css and
# /assets/css/public-v2.<SHA256_12>.css for ALL public HTML routes.
# The filename changes with the file body, so long browser caching is safe.
# The original mutable CSS names remain revalidating; no private caching.
<FilesMatch "^(?:style|public-v2)\.[a-f0-9]{12}\.css$">
Header always set Cache-Control "public, max-age=31536000, immutable" env=!PRIVATE_ROUTE
</FilesMatch>

# Private, authenticated, API and payment routes override every public cache rule.
Header always set Cache-Control "no-store, private, max-age=0" env=PRIVATE_ROUTE
Header always set Pragma "no-cache" env=PRIVATE_ROUTE
Header always set X-Robots-Tag "noindex, noarchive" env=PRIVATE_ROUTE
Header always merge Vary "Accept-Encoding"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 0 seconds"
ExpiresByType application/javascript "access plus 0 seconds"
ExpiresByType application/json "access plus 0 seconds"
ExpiresByType image/avif "access plus 0 seconds"
ExpiresByType image/webp "access plus 0 seconds"
ExpiresByType image/png "access plus 0 seconds"
ExpiresByType image/jpeg "access plus 0 seconds"
ExpiresByType image/svg+xml "access plus 0 seconds"
ExpiresByType font/woff2 "access plus 0 seconds"
</IfModule>

# Prefer Brotli when Apache provides it; otherwise use gzip/deflate.
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

