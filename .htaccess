# Bertina Linux/cPanel deployment policy
# Generated from the frozen migration baseline. Keep public URLs unchanged.

DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Preserve approved legacy migrations.
RewriteRule ^about/?$ /en/about/ [R=301,L,NE]
RewriteRule ^academic-engagements/?$ /en/academic-engagements/ [R=301,L,NE]
RewriteRule ^books/?$ /en/books/ [R=301,L,NE]
RewriteRule ^educational-philosophy/?$ /en/educational-philosophy/ [R=301,L,NE]
RewriteRule ^golden-talent/?$ /en/golden-talent/ [R=301,L,NE]
RewriteRule ^publications/?$ /en/publications/ [R=301,L,NE]
RewriteRule ^research/?$ /en/research/ [R=301,L,NE]
RewriteRule ^teaching/?$ /en/teaching/ [R=301,L,NE]
RewriteRule ^login/?$ /en/login/ [R=301,L,NE]
RewriteRule ^register/?$ /en/register/ [R=301,L,NE]
RewriteRule ^shop/?$ /fa/shop/ [R=301,L,NE]
</IfModule>

<IfModule mod_setenvif.c>
SetEnvIf Request_URI "^/(api|fa/app|app|fa/login|login|fa/register|register|fa/bazyabi-hesab|en/login|en/register|en/recover|en/account|fa/assessments|assessments|fa/shop/(cart|checkout|payment-start|payment-return|payment-result)|en/shop/(cart|checkout)|en/golden-talent/(assessment|dashboard|observer|roles|student|checkout|plans)|fa/darkhast-moshavere|en/request-consultation)(/|$)" PRIVATE_ROUTE=1
</IfModule>

<IfModule mod_headers.c>
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# Public documents/default responses must revalidate so SEO/indexing changes are visible immediately.
# Keep this at directory scope so a private route can override it reliably.
Header always set Cache-Control "public, no-cache, must-revalidate" env=!PRIVATE_ROUTE

# Versioned CSS/JS assets are revalidated daily; deployed URLs commonly carry ?v=.
<FilesMatch "\.(?:css|js|mjs)$">
Header always set Cache-Control "public, max-age=86400, stale-while-revalidate=604800" env=!PRIVATE_ROUTE
</FilesMatch>

# Media/fonts are stable and expensive to transfer, so keep them longer.
<FilesMatch "\.(?:png|jpe?g|webp|avif|gif|svg|ico|woff2?|ttf|otf)$">
Header always set Cache-Control "public, max-age=2592000, stale-while-revalidate=604800" env=!PRIVATE_ROUTE
</FilesMatch>

# Private, authenticated, API and payment routes override every public cache rule.
Header always set Cache-Control "no-store, private, max-age=0" env=PRIVATE_ROUTE
Header always set Pragma "no-cache" env=PRIVATE_ROUTE
Header always set X-Robots-Tag "noindex, noarchive" env=PRIVATE_ROUTE
Header always merge Vary "Accept-Encoding"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 day"
ExpiresByType application/javascript "access plus 1 day"
ExpiresByType application/json "access plus 0 seconds"
ExpiresByType image/avif "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# Prefer Brotli when Apache provides it; otherwise use gzip/deflate.
<IfModule mod_brotli.c>
AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

