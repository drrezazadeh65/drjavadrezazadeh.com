{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "drjavadrezazadeh-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "assistant.drjavadrezazadeh.com",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "ASSISTANT_RATE_LIMITER",
      "namespace_id": "61001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_SITE_ORIGIN": "https://drrezazadeh65.github.io/drjavadrezazadeh.com",
    "ASSISTANT_MODEL": "@cf/openai/gpt-oss-120b",
    "AI_GATEWAY_ID": ""
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEAD_STORE",
        "class_name": "LeadStore"
      }
    ]
  },
  "exports": {
    "LeadStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
