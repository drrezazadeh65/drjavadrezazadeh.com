{
  "schema_version": "1.2",
  "engine_id": "GOLDEN-TALENT-EVIDENCE-ROUTER",
  "engine_version": "1.1.0",
  "status": "PREVALIDATION",
  "purpose": "Versioned scientific prevalidation of RCAS/BAHAR-compatible evidence events into auditable D1–D6 routing, with controlled provenance independence and no learner score or diagnostic label.",
  "domains": [
    "D1",
    "D2",
    "D3",
    "D4",
    "D5",
    "D6"
  ],
  "accepted_sources": [
    "STUDENT_SELF",
    "PARENT",
    "TEACHER",
    "ACADEMIC_RECORD",
    "ASSESSMENT",
    "CONTEXT",
    "CONSULTANT",
    "PERFORMANCE_SAMPLE"
  ],
  "evidence_states": {
    "INSUFFICIENT": "No usable evidence, or evidence does not meet the minimum source rule.",
    "SINGLE_SOURCE": "Reviewed routable evidence exists, but independent provenance and/or distinct source class requirements for convergence are not satisfied.",
    "CONVERGENT": "Two independently verified, non-derivative observation clusters from at least two approved source classes carry a consistent reviewed direction; this is an evidence workflow state, not validation or learner-level certainty.",
    "DISCREPANT": "Reviewed support and contradictory direction(s), including inside one source class, or explicitly conflicting reviewed evidence; independent professional review required."
  },
  "routing_policy": {
    "total_score": false,
    "normative_cut_score": false,
    "automatic_gifted_label": false,
    "automatic_career_prescription": false,
    "minimum_independent_sources_for_convergence": 2,
    "self_report_alone_can_establish_convergence": false,
    "observer_report_alone_can_establish_convergence": false,
    "missing_evidence_is_not_negative_evidence": true,
    "context_can_limit_interpretation": true,
    "discrepancy_triggers_review": true,
    "route_priority_is_next_evidence_priority_not_talent_rank": true,
    "explicit_independence_provenance_required": true,
    "unreviewed_is_contextual_pending_review": true,
    "unmapped_contextual_observations_are_retained": true,
    "convergent_contradicting_evidence_is_not_a_talent_deficit": true,
    "repeated_observations_do_not_establish_independent_sources": true,
    "material_claim_compatibility_requires_independent_professional_review": true
  },
  "quality_rules": [
    "WITHDRAWN evidence is excluded from routing.",
    "LIMITED evidence may contextualise a route but cannot independently establish convergence.",
    "CONFLICTING evidence must remain visible and cannot be averaged away.",
    "Every route output stores links to the evidence events used.",
    "Every route run snapshots the engine policy and version.",
    "High-consequence Golden Path synthesis requires human review."
  ],
  "release_gate": {
    "empirical_validation_required_before_norms_or_cut_scores": true,
    "fairness_analysis_required": true,
    "measurement_invariance_review_required_where_applicable": true,
    "cross_source_agreement_analysis_required": true,
    "calibration_sample_required": true
  },
  "runtime": {
    "module": "platform/golden-talent-engine.mjs",
    "tests": "platform/golden-talent-engine.test.mjs",
    "deterministic": true,
    "server_intended": true,
    "engine_version": "1.1.0",
    "historic_route_versions_immutable": true,
    "operations_status": "NODE_CANDIDATE_ONLY_NOT_WIRED_INTO_BERTINA_PHP",
    "production_php_adapter": "NOT_CERTIFIED",
    "mysql_schema_alterations_required": false,
    "existing_engine_entrypoints": [
      "routeEvidence",
      "classifyDomain"
    ]
  },
  "analysis_layer": {
    "module": "platform/golden-talent-evidence-analytics.mjs",
    "purpose": "Describe evidence coverage, source diversity, discrepancy, provenance gaps, context and operational freshness without scoring the person.",
    "stale_evidence_is_not_negative": true,
    "missing_evidence_is_not_negative": true,
    "workflow_priority_is_not_talent_rank": true,
    "automatic_module_unlock": false,
    "total_score": false,
    "career_fit_score": false,
    "human_review_queue": true,
    "conservative_source_independence": "CONSUME_ROUTER_INDEPENDENCE_STATE_NOT_RAW_SOURCE_TYPE_COUNTS",
    "unreviewed_pending_review_no_deficit": true,
    "longitudinal_bahar_not_causal_inference": true,
    "convergence_is_a_reviewed_evidence_workflow_state_not_validity": true
  },
  "source_independence_policy": {
    "status": "RESEARCH_STAGE_REQUIRES_PROFESSIONAL_VERIFICATION",
    "required_provenance": [
      "independence_verified",
      "independence_group_id",
      "respondent_reference_id",
      "source_reference_id"
    ],
    "dependent_when_shared": [
      "independence_group_id",
      "respondent_reference_id",
      "source_reference_id",
      "observation_reference_id",
      "instrument_dependency_group_id",
      "derivative_of_event_id"
    ],
    "minimum_distinct_source_classes": 2,
    "minimum_verified_independent_clusters": 2,
    "never_infer_from_source_label_alone": true,
    "never_trust_browser_independence_claims": true,
    "minimum_verified_comparable_claims": 1,
    "material_compatibility_claim_fields": [
      "claim_reference_id",
      "material_compatibility_verified"
    ],
    "same_domain_and_same_direction_are_not_sufficient": true
  },
  "integrity_contract": {
    "canonicalization": "NFC JSON sorted properties, explicit error for unsupported object prototypes, accessors, cycles, unsupported scalars, duplicate normalized keys; resource bounded",
    "hash_algorithm": "SHA-256 via Node.js trusted node:crypto",
    "hash_scope": "INPUT_SORTED_CANONICAL_JSON_AND_CANONICAL_RESULT",
    "hash_consistency_is_not_authentication": true,
    "signature_required_for_authenticated_persistent_outputs": true,
    "signature_implemented_in_public_client": false,
    "verify_with_original_events_to_prove_correspondence": true
  }
}
