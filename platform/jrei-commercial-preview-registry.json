  "activation_requirements": [
    "Owner approval",
    "Real JREI action registry and verified service transport",
    "Server-side tenant authorization, job receipts and quotas",
    "Existing canonical catalogue registration, approved prices and verified settlement",
    "No entitlement before verified payment or approved contract",
    "Private no-store routes; no sensitive data in localStorage",
    "Full mobile, accessibility, localization, security and regression acceptance"
  ],
  "release": {
    "workflow": ".github/workflows/deploy-bertina.yml",
    "branch": "migration/bertina-linux6",
    "automatic": false,
    "owner_dispatch_only": true
  },
  "exclusions": [
    "parallel accounts",
    "parallel checkout",
    "parallel customer database",
    "public engine code",
    "unverified payment or entitlement"
  ]
