{
  "schema_version": "1.1",
  "architecture_version": "5.0",
  "status": "FROZEN_EXTENSIBLE_BASELINE",
  "purpose": "Machine-readable boundary contract for public web, private app, commerce, assessment, publishing, research and future ecosystem modules.",
  "origins": {
    "current_public_origin": "https://drjavadrezazadeh.com",
    "production_target": "https://drjavadrezazadeh.com",
    "app_target": "https://app.drjavadrezazadeh.com",
    "journal_target": "https://journal.drjavadrezazadeh.com",
    "press_target": "https://press.drjavadrezazadeh.com",
    "api_target": "https://api.drjavadrezazadeh.com"
  },
  "locales": {
    "supported": [
      "fa",
      "en"
    ],
    "localized_namespaces": [
      "/fa/",
      "/en/"
    ],
    "root_gateway": "NEUTRAL_LANGUAGE_GATEWAY",
    "automatic_ip_language_redirect": false,
    "language_choice_user_controlled": true
  },
  "policies": {
    "PUBLIC_CANDIDATE": {
      "authentication": "NONE",
      "data_class": "PUBLIC",
      "indexing": "EXPLICIT_RELEASE_ONLY",
      "sitemap": "EXPLICIT_RELEASE_ONLY",
      "cache": "PUBLIC_REVALIDATE"
    },
    "AUTH_SHELL": {
      "authentication": "REQUIRED_FOR_REAL_SERVICE",
      "data_class": "PRIVATE",
      "indexing": "NOINDEX",
      "sitemap": "EXCLUDE",
      "cache": "NO_STORE"
    },
    "PRIVATE_APP": {
      "authentication": "REQUIRED",
      "data_class": "PRIVATE",
      "indexing": "NOINDEX",
      "sitemap": "EXCLUDE",
      "cache": "NO_STORE"
    },
    "PRIVATE_ASSESSMENT": {
      "authentication": "REQUIRED",
      "data_class": "SENSITIVE_EDUCATIONAL",
      "indexing": "NOINDEX",
      "sitemap": "EXCLUDE",
      "cache": "NO_STORE"
    },
    "TRANSACTIONAL": {
      "authentication": "SERVER_AUTHORITATIVE",
      "data_class": "PRIVATE_TRANSACTIONAL",
      "indexing": "NOINDEX",
      "sitemap": "EXCLUDE",
      "cache": "NO_STORE"
    },
    "PUBLIC_NO_INDEX": {
      "authentication": "NONE",
      "data_class": "PUBLIC_UTILITY",
      "indexing": "NOINDEX",
      "sitemap": "EXCLUDE",
      "cache": "PUBLIC_REVALIDATE"
    }
  },
