# JR Cache Standard v2.0
# NOTE: GitHub Pages ignores this file. It is the canonical header policy for any future
# host/CDN that supports _headers semantics (e.g. Cloudflare Pages) so migration does
# not reintroduce stale HTML, stale service workers, or unsafe private caching.

/*
  Cache-Control: no-cache
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/sw.js
  Cache-Control: no-cache

/site.webmanifest
  Cache-Control: no-cache

/assets/css/*
  Cache-Control: no-cache

/assets/js/*
  Cache-Control: no-cache

/assets/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Keep preview hostnames out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, noarchive

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, noarchive

# Private / transactional surfaces: never store, never index.
