# Cloudflare Pages response-header policy.
# GitHub Pages ignores this file; Cloudflare Pages applies it after cutover.
# Do not add production CSP here until every inline script/style dependency is audited.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Keep Cloudflare preview hostnames out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, noarchive

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, noarchive

